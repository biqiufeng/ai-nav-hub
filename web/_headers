/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

/admin/*
  X-Robots-Tag: noindex, nofollow
  Cache-Control: no-store

/data/catalog.json
  Cache-Control: public, max-age=300, must-revalidate

/data/hotlist.json
  Cache-Control: public, max-age=300, must-revalidate
